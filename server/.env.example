# Server Port
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/cosmetics_ecommerce

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials
ADMIN_EMAIL=admin@cosmetics.com
ADMIN_PASSWORD=AdminPassword123!

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# WhatsApp Ordering Business Number (with country code, no + or spaces)
WHATSAPP_BUSINESS_NUMBER=94771234567

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=1220000
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret_here
PAYHERE_CURRENCY=LKR

# PayHere URLs
PAYHERE_SANDBOX_URL=https://sandbox.payhere.lk/pay/checkout
PAYHERE_RETURN_URL=http://localhost:5173/payment/success
PAYHERE_CANCEL_URL=http://localhost:5173/payment/cancel
PAYHERE_NOTIFY_URL=http://localhost:5000/api/payments/payhere/notify

# Environment
NODE_ENV=development
